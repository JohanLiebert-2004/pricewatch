[Unit]
Description=Dealwatch independent external health watchdog

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/pricewatch-runtime/source
EnvironmentFile=%h/.config/pricewatch-runtime/collector.env
ExecStart=%h/.local/share/pricewatch-runtime/venv/bin/python3 %h/.local/share/pricewatch-runtime/source/scripts/watchdog.py
UMask=0077
TimeoutStartSec=180
KillMode=control-group
